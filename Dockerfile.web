FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY index.html menu.html admin-dashboard.html reservations.html orders.html customers.html manage.html /usr/share/nginx/html/
COPY css /usr/share/nginx/html/css
COPY js /usr/share/nginx/html/js
COPY css/manage.css /usr/share/nginx/html/css/manage.css
COPY images /usr/share/nginx/html/images
COPY fonts /usr/share/nginx/html/fonts
COPY fullcalendar /usr/share/nginx/html/fullcalendar

HEALTHCHECK --interval=10s --timeout=5s --retries=5 CMD wget -qO- http://127.0.0.1/ || exit 1
