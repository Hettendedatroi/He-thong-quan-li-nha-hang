# PostgreSQL credentials: change before deploying
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=change-this-to-a-long-random-password
POSTGRES_DB=restaurant_db

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
CLOUDFLARE_TUNNEL_TOKEN=paste-your-tunnel-token-here

# Local web port; Cloudflare Tunnel connects to this compose service internally
WEB_PORT=8080
