# ===== Server =====
PORT=3000
NODE_ENV=development
# Danh sách origin của frontend, cách nhau bằng dấu phẩy (để trống = cho phép tất cả khi dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# URL web khách hàng - dùng để sinh link trong mã QR của bàn
PUBLIC_WEB_URL=http://localhost:5173
# URL public của chính backend - dùng cho link thanh toán cọc giả lập
API_PUBLIC_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_UTC_OFFSET=+07:00

# ===== Database (khớp với docker-compose.yml) =====
DATABASE_URL=postgresql://restaurant:restaurant@localhost:5432/restaurant_db?schema=public

# ===== Auth =====
# Đổi thành chuỗi ngẫu nhiên dài khi deploy
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Đăng nhập Google: điền Client ID để kiểm tra "aud" của id_token (có thể để trống khi dev)
GOOGLE_CLIENT_ID=

# ===== Mã hóa dữ liệu thanh toán (NFR-03) =====
PAYMENT_ENCRYPTION_KEY=change-me-another-long-random-string

# ===== Email (SMTP) - để trống thì email chỉ được in ra log =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nha hang Group 4 <no-reply@restaurant.local>"

# ===== Tích hợp máy chấm công (FR-MGR-18) =====
TIMEKEEPER_API_KEY=change-me-timekeeper-key

# ===== Xuất PDF: font hỗ trợ tiếng Việt (để trống sẽ tự dò Arial/DejaVu) =====
PDF_FONT_PATH=
